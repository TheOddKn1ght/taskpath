{
  "name": "taskpath-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Taskpath desktop client",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "app.taskpath.desktop",
    "productName": "Taskpath",
    "artifactName": "Taskpath-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out"
    },
    "files": ["main.cjs", "policy.cjs", "package.json"],
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}
