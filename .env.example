HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/taskpath-accounts.sqlite
# Optional Docker Compose startup mode. Default: start.
# Use start:smol to enable Bun's --smol flag (less memory, more frequent GC).
# For local runs, use: bun run start:smol
# TASKPATH_START_SCRIPT=start:smol
# Set your IANA timezone before first start. Defaults to your system timezone.
# TASKPATH_TIMEZONE=Europe/Moscow
# Public origin when served behind an HTTPS reverse proxy.
# TASKPATH_ORIGIN=https://tasks.example.com
# Background push uses this HTTPS origin as its default VAPID contact.
# Optional contact override; signing keys are generated once and kept in SQLite.
# TASKPATH_PUSH_SUBJECT=mailto:admin@example.com
# Authentication and encryption are always required. Create a 24-hour invitation
# with bun run admin invite (or docker compose exec taskpath bun run admin invite).
# Startup does not issue invitations. Recipients set their passwords in the browser.
# Never set TASKPATH_USERNAME, TASKPATH_PASSWORD, or TASKPATH_PASSWORD_HASH.
# Legacy plaintext databases are refused; use a fresh database or Docker volume.
# Session lifetime in whole days, from 1 to 365. Defaults to 30.
# TASKPATH_SESSION_DAYS=30
