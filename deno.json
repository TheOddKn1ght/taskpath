{
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run src/server.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run --watch src/server.ts",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-ffi scripts/build.ts",
    "admin": "deno run --allow-read --allow-write --allow-env src/admin.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-run tests/",
    "qa": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run tests/browser-server.ts",
    "typecheck": "deno check src/server.ts src/admin.ts scripts/build.ts tests/*.test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "esbuild": "npm:esbuild@0.25.0",
    "hash-wasm": "npm:hash-wasm@4.12.0",
    "web-push": "npm:web-push@3.6.7",
    "ws": "npm:ws@8.18.0",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@tailwindcss/oxide": "npm:@tailwindcss/oxide@4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "npm:@tailwindcss/oxide-linux-x64-gnu@4.3.3"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "Deno.ns"]
  }
}
