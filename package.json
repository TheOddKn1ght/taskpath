{
  "name": "taskpath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A little space to plan your week and focus your day.",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "NODE_ENV=production bun run src/server.ts",
    "start:smol": "NODE_ENV=production bun --smol run src/server.ts",
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "dev:smol": "NODE_ENV=development bun --smol --watch src/server.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "admin": "bun run src/admin.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
