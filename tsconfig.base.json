{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [],
    "lib": [
      "ESNext"
    ],
    "paths": {
      "/assets/__TASKPATH_RELEASE__/*": [
        "./public/*"
      ]
    }
  }
}
